# Environment Variables Configuration
# Copy this file to .env and adjust values as needed.

# Database connection
# Default SQLite local database for instant zero-dependency setup
DATABASE_URL="file:./dev.db"

# For PostgreSQL (Docker or managed cloud PostgreSQL):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/telangana_schemes?schema=public"

# Authentication secret for signing admin JWT sessions
# Generate a strong 32+ character random string for production
AUTH_SECRET="telangana-schemes-dev-secret-key-change-in-production-min32chars"

# Optional: LLM API Key (Google Gemini API)
# The application has a full built-in natural-language semantic retrieval engine that works 100% offline
# without any API key. If provided, the backend will enhance responses while strictly grounding on DB records.
GEMINI_API_KEY=""

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Rate limiting settings for public chatbot API
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
